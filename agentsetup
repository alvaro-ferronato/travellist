#check if platform is installed
checkPlatformInstalled()
{
    CHECK_CMD="${FSDTOOL} --platform"
    log_msg "Checking if platform is installed..."
    ${CHECK_CMD} 2>&1 | tee -a $_LOGFILE; ret=${PIPESTATUS[0]}
    log_msg "Running ${CHECK_CMD} returned $ret"
    case $ret in
        0) log_msg "Platform is installed";;
        1) log_msg "Error initializing platform, EapService may not be started.";;
        6) log_msg "Platform is not installed or liveupdate not completed yet.";;
        *) log_msg "Unknown error during platform check.";;
    esac
    return $ret
}

# checkProducts
# return values from this function:
#  0 - There are one or more products installed
#  1 - There was an error communicating with the platform
#  2 - There are no products installed
checkProducts()
{
    local CHECK_CMD="${AGENTCLI} info product"
    local CHECK_OUTPUT
    local MAX_RETRIES=10
    local RETRY_DURATION=3
    for i in $(seq 1 ${MAX_RETRIES}); do
        CHECK_OUTPUT=$(${CHECK_CMD} 2>&1)
        ret=$?
        CHECK_INSTALLED_PRODUCTS=""
        log_msg "Running ${CHECK_CMD} [${i}/${MAX_RETRIES}] returncode=$ret, output=\"${CHECK_OUTPUT}\""
        if [ $ret -ne 0 ]; then
            log_msg "Error running agentcli: $ret; Waiting ${RETRY_DURATION} seconds and trying again"
            if [ ${i} -eq 3 ] || [ $((i % 20)) -eq 0 ]; then
                # If we fail three times here, give an indication that something isn't right but we are trying
                # And also give an update every ~1minute that we're still trying
                log_msg "Attempting to reconnect to the Agent..." 1
            fi
            sleep ${RETRY_DURATION}
            continue
        else
            break
        fi
    done

    if [ $ret -ne 0 ]; then
        log_msg "Exhausted all ${MAX_RETRIES} retries to get list of products; Agent appears to be offline or unreachable" 1
        log_msg "To force uninstall, run: /usr/lib/broadcom/esa/uninstall.sh --force" 1
        return 1
    fi

    local PFLAG=0
    while IFS= read -r line; do
        if [ $PFLAG -eq 1 ]; then
            local PRODUCT=$(echo $line | awk -F':' '{print $1}'); ret=$?
            if [ $ret -eq 0 ]; then
                log_msg "The ${PRODUCT} product is installed"
                if [ "${CHECK_INSTALLED_PRODUCTS}" = "" ]; then
                    CHECK_INSTALLED_PRODUCTS="${PRODUCT}"
                else
                    CHECK_INSTALLED_PRODUCTS="${CHECK_INSTALLED_PRODUCTS},${PRODUCT}"
                fi
            fi
        else
            TEST=$(echo $line | grep "Installed Products:"); ret=$?
            if [ $ret -eq 0 ]; then
                PFLAG=1
            fi
        fi
    done <<< "${CHECK_OUTPUT}"
    if [ "${CHECK_INSTALLED_PRODUCTS}" = "" ]; then
        log_msg "There are no products installed"
        return 2
    fi
    log_msg "There are one or more products installed"
    log_msg "Product List = ${CHECK_INSTALLED_PRODUCTS}"
    return 0
}

esaProductUninstall()
{
    if [ "${UNINSTALL_PRODUCT}" = "" ]; then
        log_msg "You must specify a product to uninstall!" 1
        return 10
    fi
    UNINSTALL_CMD="${FSDTOOL} --uninstall ${UNINSTALL_PRODUCT}"
    log_msg "Uninstalling ${UNINSTALL_PRODUCT}, this may take some time ..." 1
    ${UNINSTALL_CMD} 2>&1 | tee -a $_LOGFILE; ret=${PIPESTATUS[0]}
    log_msg "Running ${UNINSTALL_CMD} returned $ret"
    case $ret in
        0) log_msg "${UNINSTALL_PRODUCT} product uninstallation was successful." 1;;
        1) log_msg "Error initializing communication with the $PRODUCT_ID platform." 1;;
        2) log_msg "There are no products installed." 1;;
        3) log_msg "${UNINSTALL_PRODUCT} product is not installed." 1;;
        4) log_msg "Invalid password." 1;;
        5) log_msg "Error during uninstall of ${UNINSTALL_PRODUCT}." 1;;
        *) log_msg "Unknown error during uninstall." 1;;
    esac
    return $ret
}

antimalware_feature_update()
{
    #Only if DCS is on the box
    local INSTALLREG_FILE=/etc/sisips/install.reg
    [ ! -f "$INSTALLREG_FILE" ] && return 0
    AGENT_TYPE=$(grep -E '^AgentType=' "$INSTALLREG_FILE" | cut -d'=' -f2)
    [ -z "$AGENT_TYPE" ] && return 0
