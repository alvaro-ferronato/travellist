} 

disableESARepo()
{
  ( [ ! -f $REPOFILE ] || [ $debugMode = true ] ) && return 0
  # Only disable if DISABLE_REPO flag is set (repo was never successfully accessed)
  # Don't disable if it was successfully enabled during execution (e.g., fallback worked)
  if [ $DISABLE_REPO = true ]; then
    case $PKG_MGR in 
       yum|zypp|dnf|tdnf) sed -i 's/^enabled=1/enabled=0/g' $REPOFILE 2>/dev/null;;
       apt) sed -i -r "s|^deb (.*)$|# deb \1|g" $REPOFILE 2>/dev/null;;
    esac
  fi
  return 0
}

# Remove proxy configuration lines from repository file
removeRepoProxyLines()
{
  [ ! -f $REPOFILE ] && return 0
  sed -i '/^proxy=/d' $REPOFILE 2>/dev/null
  return 0
}

# Configure proxy settings in repository file
# For yum/dnf/zypp: Add proxy= lines to repo file
# For apt: Use Acquire::http::Proxy in apt.conf.d
configureRepoProxy()
{
  local proxy_url="$1"  # e.g., "http://user:pass@host:port" or empty to remove
  
  [ ! -f $REPOFILE ] && return 0
  
  case $PKG_MGR in
    yum|zypp|dnf|tdnf)
      if [ ! -z "$proxy_url" ]; then
        log_msg "Configuring proxy in repo file"
        # Remove any existing proxy lines
        removeRepoProxyLines
        # Add proxy configuration after [ESA] section
        sed -i "/^\[ESA\]/a proxy=$proxy_url" $REPOFILE 2>/dev/null
      else
        log_msg "Removing proxy configuration from repo file"
        removeRepoProxyLines
      fi
      ;;
    apt)
      local apt_proxy_conf="/etc/apt/apt.conf.d/90esa-proxy"
      if [ ! -z "$proxy_url" ]; then
        log_msg "Configuring proxy in apt config"
        cat > "$apt_proxy_conf" <<EOF
// ESA Proxy Configuration
Acquire::http::Proxy "$proxy_url";
Acquire::https::Proxy "$proxy_url";
EOF
      else
        log_msg "Removing proxy configuration from apt"
        rm -f "$apt_proxy_conf" 2>/dev/null
      fi
      ;;
  esac
  
  # Re-enable debug tracing if it was enabled
  [ "$debug_was_enabled" = true ] && set -x
  return 0
}

enableESARepo()
{
  [ ! -f $REPOFILE ] && return 1
  case $PKG_MGR in 
     yum|zypp|dnf|tdnf) sed -i 's/^enabled=0/enabled=1/g' $REPOFILE 2>/dev/null;;
     apt) sed -i -r "s|^#.*deb (.*)$|deb \1|g" $REPOFILE 2>/dev/null;;
  esac
  return 0
}

refreshESARepo()
{
  [ $DISABLE_REPO = false ] && enableESARepo || { log_msg "Repo is disabled or $REPOFILE missing.. not refreshing."; REPO_COMM_STATUS=1; DISABLE_REPO=true; return 1; }

  # clean any old yum cache and get new cache
  log_msg "Refreshing repo cache and testing connection.."
  local ret;
  case $PKG_MGR in
     yum) ret=`yum --disablerepo="*" --enablerepo="ESA" clean all 2>&1`; log_msg "$ret" 
          ret=`yum --disablerepo="*" --enablerepo="ESA" makecache 2>&1`; log_msg "$ret"
          echo "$ret" |grep -iq 'Error\|Errno' && { log_msg "YUM Repo communication error:\n" 1; box_msg "$ret"; REPO_COMM_STATUS=1; } ;;
     tdnf) ret=`tdnf --disablerepo="*" --enablerepo="ESA" clean all 2>&1`; log_msg "$ret"
          ret=`tdnf --disablerepo="*" --enablerepo="ESA" makecache 2>&1`; log_msg "$ret"
          echo "$ret" |grep -iq 'Error\|Errno' && { log_msg "TDNF Repo communication error:\n" 1; box_msg "$ret"; REPO_COMM_STATUS=1; } ;;
     zypp) ret=`zypper -n refresh -f ESA 2>&1`; zypper_rc=$?; log_msg "$ret"
          [ $zypper_rc != 0 ] && { log_msg "Zypper Repo communication error:\n" 1; box_msg "$ret"; REPO_COMM_STATUS=1; } ;;
     apt) rm -rf /var/lib/apt/lists/${REPO_URL%%/*}*
          ret=`apt-get update -o Dir::Etc::sourcelist="sources.list.d/esa.list" \
           -o Dir::Etc::sourceparts="-" -o APT::Get::List-Cleanup="0" 2>&1;`; log_msg "$ret"
          ( echo "$ret" |grep -q "^E: Failed\|^Err" ) || [ `echo "$ret" |wc -l` -le 1 ] && \
             { log_msg "APT Repo communication error:\n" 1; box_msg "$ret"; REPO_COMM_STATUS=1; } ;;
  esac

  if [ $REPO_COMM_STATUS = 1 ]; then
     DISABLE_REPO=true
     log_msg "The Broadcom Endpoint Security Agent for Linux repo was not accessible.\n" 1
     #log_msg "You may be able to use the seplpkg tool from another machine to create a full offline install.\n" 1
     log_msg "NOTICE: Unable to communicate with repository. Check repo file $REPOFILE" 0 1
     if [ ! -z "$http_proxy" ] || [ ! -z "$https_proxy" ]; then
       log_msg "NOTICE: Proxy settings detected. Please verify proxy configuration is correct.\n" 0 1
     else
       log_msg "" 0 1
     fi
  fi
  log_msg "Repo communication status = $REPO_COMM_STATUS"
  return $REPO_COMM_STATUS;
}

# Test if we can actually list packages from the repository
testRepoPackageAccess()
{
  local test_pkg="$AGENT_PACKAGE"
  log_msg "Testing repository package access for $test_pkg"
  
  case $PKG_MGR in
    dnf | yum) 
      # Force refresh to avoid using stale cache - use --refresh to ensure real connection test
      local test_result=$($PKG_MGR --disablerepo="*" --enablerepo="ESA" --refresh list available $test_pkg 2>&1)
      log_msg "Package list test result (available): $test_result"
      
      if echo "$test_result" | grep -iq "Error\|No matching Packages"; then
        test_result=$($PKG_MGR --disablerepo="*" --enablerepo="ESA" --refresh list $test_pkg 2>&1)
        log_msg "Package list test result (all): $test_result"
      fi
      
      # Check for certificate errors
      echo "$test_result" | grep -Eiq "$CERT_ERROR_PATTERN" && REPO_CERT_ERROR=1
      
      # Check for ignored repos (connection failure) or other errors
      echo "$test_result" | grep -iq "Ignoring repositories" && { log_msg "Repository was ignored (likely connection failed with skip_if_unavailable), treating as failure"; return 1; }
      echo "$test_result" | grep -iq "Error\|No matching Packages" && return 1
      ;;
      
    tdnf) 
      # Force refresh to avoid using stale cache
      local test_result=$($PKG_MGR --disablerepo="*" --enablerepo="ESA" --refresh list available $test_pkg 2>&1)
      log_msg "Package list test result (available): $test_result"
      
      if echo "$test_result" | grep -iq "Error\|No matching Packages"; then
        test_result=$($PKG_MGR --disablerepo="*" --enablerepo="ESA" --refresh list $test_pkg 2>&1)
        log_msg "Package list test result (all): $test_result"  
      fi
      
      # Check for certificate errors
      echo "$test_result" | grep -Eiq "$CERT_ERROR_PATTERN" && REPO_CERT_ERROR=1
      
      # Check if repo was ignored
      if echo "$test_result" | grep -iq "Ignoring repositories"; then
        log_msg "Repository was ignored, treating as failure"
        return 1
      fi
      
      echo "$test_result" | grep -iq "Error\|No matching Packages" && return 1
      ;;
      
    zypp) 
      # Use zypper to search for package in ESA repo
      # -n = non-interactive, -x = exact match, -r = from specific repo
      local test_result=$(zypper -n search -x -r ESA $test_pkg 2>&1)
      log_msg "Package list test result: $test_result"
      
      # Check for certificate errors
      echo "$test_result" | grep -Eiq "$CERT_ERROR_PATTERN" && REPO_CERT_ERROR=1
      
      # Check for repository failures
      # Zypper may show "Skipping repository", "Repository is invalid", or "Download failed"
      if echo "$test_result" | grep -iq "Skipping repository\|Repository.*invalid\|Download.*failed\|Can't provide.*repository"; then
        log_msg "Repository was skipped or inaccessible, treating as failure"
        return 1
      fi
      
      # Check for other errors
      echo "$test_result" | grep -iq "Error" && return 1
      ;;
      
    apt) 
      # For apt, we need to test if we can actually access the repository
      # apt-cache madison shows available versions from all configured sources
      local test_result=$(apt-cache madison $test_pkg 2>&1)
      log_msg "Package list test result: $test_result"
      
      # Check for certificate errors
      echo "$test_result" | grep -Eiq "$CERT_ERROR_PATTERN" && REPO_CERT_ERROR=1
      
      # Check if result is empty (package not found) or contains errors
      if [ -z "$test_result" ]; then
        log_msg "No package information available from repository"
        return 1
      fi

      ;;
  esac
  
  log_msg "Repository package access test passed"
  return 0
}

configureESARepo()
{
  local UPDATE_REPO=false

  if [ -f $REPOFILE ]; then
    grep -q "#.*DisableRepo=true" $REPOFILE && { DISABLE_REPO=true; REPO_ENABLE=0; } #allow override
    if ! grep -q "$RELEASE_VERSION" $REPOFILE; then
      UPDATE_REPO=true
      log_msg "Appears to be upgrade, so updating repo file"
    else log_msg "Not updating repo file.."
    fi
  else UPDATE_REPO=true
  fi

  if [ $UPDATE_REPO = true ]; then
    if [ -f $REPOFILE ] && [ -d /etc/broadcom/esa ]; then
      repo_bak=/etc/broadcom/esa/`basename $REPOFILE`.prev
      log_msg "backing up previous repo file to $repo_bak" && mv -f $REPOFILE $repo_bak
    fi
    [ -f ${REPOFILE}.prev ] && rm -f ${REPOFILE}.prev

    local BASE_URL="${REPO_URL}"
    local REPO_ENABLE=1

    [ $DISABLE_REPO = true ] && REPO_ENABLE=0

    case $PKG_MGR in
      yum|zypp|dnf|tdnf)
        BASE_URL="${BASE_URL}/RPM/${PLAT_ARCH}"
        cat > $REPOFILE 2>>$_LOGFILE <<EOF
# Broadcom Endpoint Security Agent for Linux repository
# DisableRepo=$DISABLE_REPO
[ESA]
name=Broadcom Endpoint Security Agent for Linux repository
baseurl=${BASE_URL}
enabled=$REPO_ENABLE
gpgcheck=$GPG_CHECK
gpgkey=file://${REPO_GPG_PATH}
skip_if_unavailable=1
EOF
        # Add timeout/retry settings for tdnf (as it may not timeout)
        [ $PKG_MGR = tdnf ] && echo -e "timeout=20\nretries=3" >> $REPOFILE
        ;;
      apt)
        BASE_URL="${BASE_URL}/Debian"
        [ $REPO_ENABLE = 0 ] && HASH="# " || HASH=""
        
        REPO_TAG="[ arch=amd64 lang=none signed-by=$REPO_GPG_PATH ]"
        [ "$PLAT_ARCH" = "aarch64" ] && REPO_TAG="[ arch=arm64 lang=none signed-by=$REPO_GPG_PATH ]"
        cat > $REPOFILE 2>>$_LOGFILE <<EOF
# Broadcom Endpoint Security Agent for Linux repository
# DisableRepo=$DISABLE_REPO
${HASH}deb ${REPO_TAG} ${BASE_URL} . main
EOF
        ;;
      esac
    fi

    [ "$PKG_MGR" = "zypp" ] && cat >/etc/zypp/vendors.d/broadcom 2>>$_LOGFILE <<EOF
[main]
vendors = Broadcom
EOF

  # Retry logic with proxy fallback
  local MAX_REPO_RETRIES=2
  local repo_retry_count=0
  local repo_refresh_success=false

  while [ $repo_retry_count -lt $MAX_REPO_RETRIES ] && [ $repo_refresh_success = false ]; do
    repo_retry_count=$((repo_retry_count + 1))
    
    # Reset state before each attempt
    REPO_COMM_STATUS=0
    DISABLE_REPO=false
    
    if [ $repo_retry_count -eq 1 ]; then
      # First attempt - with proxy if configured
      if [ "$PROXY_FROM_MANIFEST" = "true" ]; then
        log_msg "Trying repository connection with proxy settings from manifest" 1
        # Temporarily disable debug tracing
        local debug_was_enabled=false
        if [[ $- == *x* ]]; then
            debug_was_enabled=true
            set +x
        fi
        # Configure proxy in repo file for yum/dnf/apt
        if [ ! -z "$http_proxy" ]; then
          configureRepoProxy "$http_proxy"
        fi
        # Re-enable debug tracing if it was enabled
        [ "$debug_was_enabled" = true ] && set -x
      else
        log_msg "Trying repository connection (no proxy configured)"
      fi
    else
      # Second attempt - clear proxy and retry
      if [ "$PROXY_FROM_MANIFEST" = "true" ]; then
        log_msg "Repository connection failed with proxy, retrying without proxy" 1
        # Temporarily disable debug
        local debug_was_enabled=false
        if [[ $- == *x* ]]; then
            debug_was_enabled=true
            set +x
        fi
        # Remove proxy from repo file
        configureRepoProxy ""
        # Unset proxy environment variables so package manager doesn't use them
        unset http_proxy https_proxy HTTP_PROXY HTTPS_PROXY
        # Re-enable debug tracing if it was enabled
        [ "$debug_was_enabled" = true ] && set -x
      else
        log_msg "Retrying repository connection (no proxy configured)"
      fi
    fi

    refreshESARepo
    local refresh_ret=$?
    
    # Even if refresh succeeds, test if we can actually list packages
    if [ $refresh_ret -eq 0 ]; then
      log_msg "Repository metadata refresh successful, testing package access..."
      testRepoPackageAccess
      local package_test_ret=$?
      
      if [ $package_test_ret -eq 0 ]; then
        repo_refresh_success=true
        log_msg "Repository connection successful on attempt $repo_retry_count"
        
        # If we succeeded without proxy on second attempt, keep proxy cleared
        if [ $repo_retry_count -eq 2 ] && [ "$PROXY_FROM_MANIFEST" = "true" ]; then
          log_msg "Repository is accessible without proxy. Proxy settings will remain disabled for this installation." 1
          PROXY_FROM_MANIFEST=false
        fi
      else
        log_msg "Repository package access test failed on attempt $repo_retry_count"
        REPO_COMM_STATUS=1
      fi
    else
      log_msg "Repository metadata refresh failed on attempt $repo_retry_count (return code: $refresh_ret)"
      REPO_COMM_STATUS=1
    fi
  done

  # If all retries failed
  if [ $repo_refresh_success = false ]; then
    log_msg "Repository connection failed after $MAX_REPO_RETRIES attempts"
    REPO_COMM_STATUS=1
    DISABLE_REPO=true
    return 1
  fi

  # Success - ensure REPO_COMM_STATUS is set to success
  REPO_COMM_STATUS=0
  return 0
}

version_ge() { test "$(printf '%s\n' "$@" | sort -V | head -n 1)" != "$1" -o "$1" = "$2"; }
getval() { [ "$1" ] && [[ "$1" != --* ]] && [[ "$1" != -? ]] && echo -n "$1" && return 0 || return 1; }

#-------------------------------------------------------
#  parentHasLock() Function
#  Parameters: $1 - starting pid (MYPID)
#  Purpose: Detect if we're getting into a recursive lock situation
#    by iterating over parent processes, looking to see if lockfile is
#    held by a parent process (LOCK_FILE held with fd 10 -- see call to flock)
#    if it is return 0 so we don't call waitForRunLock, otherwise, we wait
#-------------------------------------------------------
parentHasLock() 
{
  local _ppid=${1:-$MYPID};
  while [ "$_ppid" ] && [ $_ppid -gt 1 ]; do
    if [ "`readlink /proc/$_ppid/fd/10`" = "$LOCK_FILE" ]; then
      log_msg "Parent process $_ppid already holding lock, continue on"
      return 0
    else _ppid=`awk '/^PPid:/ {print $2}' /proc/$_ppid/status`
    fi
  done
  return 1
}

#-------------------------------------------------------
#  waitForRunLock() Function
#  Parameters: LOCK_TMOUT_SEC (env) - default 120
#  Purpose: Wait for up to LOCK_TMOUT_SEC for exclusive run lock
#  Prerequisite: flock holding exclusive lock for fd 10 (LOCK_FILE)
#-------------------------------------------------------
waitForRunLock()
{
  log_msg "Waiting for instance run lock .." 1
  flock -w $LOCK_TMOUT_SEC -e 10 || error $? "Timeout exceeded $LOCK_TMOUT_SEC waiting for instance lock"
  sleep .5
}

setupManifestLink()
{
  if [ ! -z "$PAYLOAD_TEMP_DIR" ] && [ -e "$PAYLOAD_TEMP_DIR/$MANIFEST_NAME" ]; then
    log_msg "Loading manifest from fsd file $PAYLOAD_TEMP_DIR/$MANIFEST_NAME"
    ln -s $(realpath $PAYLOAD_TEMP_DIR/$MANIFEST_NAME) $TEMP_MANIFEST_LINK
  elif [ -e "$SCRIPT_DIR/$MANIFEST_NAME" ]; then
    log_msg "Loading manifest from json file $SCRIPT_DIR/$MANIFEST_NAME"
    ln -s $(realpath $SCRIPT_DIR/$MANIFEST_NAME) $TEMP_MANIFEST_LINK
  fi
}
# Percent-encode a string for safe embedding in a URL userinfo component.
# Encodes all characters except the RFC 3986 unreserved set (A-Z a-z 0-9 - _ . ~).
# Special URL characters like '@', ':', '#', '/', '?' are encoded so they cannot
# be misinterpreted as URL delimiters when used in proxy credentials.
url_encode_component()
{
    local LC_ALL=C
    local string="$1"
    local length="${#string}"
    local encoded=""
    local i c hex
    for (( i=0; i<length; i++ )); do
        c="${string:i:1}"
        case "$c" in
            [a-zA-Z0-9._~-]) encoded+="$c" ;;
            *) printf -v hex '%%%02X' "'$c"; encoded+="$hex" ;;
        esac
    done
    printf '%s' "$encoded"
}

# Function to extract and set proxy settings
extractAndSetProxySettings()
{
  # Temporarily disable debug tracing to prevent password exposure during entire proxy setup
  local debug_was_enabled=false
  if [[ $- == *x* ]]; then
      debug_was_enabled=true
      set +x
  fi
  
  # Extract proxy settings using fsdmanifest tool if manifest exists
  if [ -f "$TEMP_MANIFEST_LINK" ] && [ -f "$PAYLOAD_TEMP_DIR/fsdmanifest" ]; then
      log_msg "Extracting proxy settings from manifest using fsdmanifest tool"
      
      # Create expected directory structure for fsdmanifest
      local FSDMANIFEST_PROXY_DIR="/var/opt/Broadcom/EndpointSecurityAgent/appdata"
      mkdir -p "$FSDMANIFEST_PROXY_DIR"
      
      # Make fsdmanifest executable and run it to extract proxy settings
      chmod +x "$PAYLOAD_TEMP_DIR/fsdmanifest"
      # Run fsdmanifest to save proxy.dat to appdata/ so proxy_manager (libspeng_slim.so)
      # picks it up for the very first LU session (CRE-24316).
      "$PAYLOAD_TEMP_DIR/fsdmanifest" -m "$TEMP_MANIFEST_LINK" -p >>$_LOGFILE 2>&1
      local ret_code=$?
      if [ $ret_code -ne 0 ]; then
          log_msg "ERROR: fsdmanifest command to save proxy.dat failed with exit code $ret_code" 1
          return $ret_code
      fi
      
      # Run fsdmanifest to decrypt proxy password
      log_msg "Decrypting proxy password from manifest..."
      local DECRYPTED_PROXY_PASSWORD=$("$PAYLOAD_TEMP_DIR/fsdmanifest" -m "$TEMP_MANIFEST_LINK" --decrypt-proxy-password 2>&1)
      ret_code=$?
      if [ $ret_code -ne 0 ]; then
          log_msg "ERROR: fsdmanifest command to decrypt proxy password failed with exit code $ret_code" 1
          log_msg "ERROR: Proxy password decryption failed" 1
          log_msg "WARNING: Proxy configuration from manifest failed. Installation will proceed without proxy." 1
          log_msg "NOTE: Repository connection will be attempted without proxy. If proxy is required, installation may fail." 1
          # Re-enable debug tracing if it was enabled before returning
          [ "$debug_was_enabled" = true ] && set -x
          return $ret_code
      fi
      log_msg "Proxy password decrypted successfully"

      # Read proxy.dat
      local PROXY_DAT_FILE="$FSDMANIFEST_PROXY_DIR/proxy.dat"
      if [ -f "$PROXY_DAT_FILE" ]; then
          log_msg "Proxy file extracted to $PROXY_DAT_FILE"
          
          local PROXY_SERVER=$(grep -oP '"server":\s*"\K[^"]+' "$PROXY_DAT_FILE" 2>/dev/null)
          local PROXY_PORT=$(grep -oP '"port":\s*\K\d+' "$PROXY_DAT_FILE" 2>/dev/null)
          local PROXY_USER=$(grep -oP '"user":\s*"\K[^"]+' "$PROXY_DAT_FILE" 2>/dev/null)
          local PROXY_PASSWORD="$DECRYPTED_PROXY_PASSWORD"
          
          if [ ! -z "$PROXY_SERVER" ] && [ ! -z "$PROXY_PORT" ]; then
              local PROXY_AUTH_STR=""
              if [ ! -z "$PROXY_USER" ] && [ ! -z "$PROXY_PASSWORD" ]; then
                  local ENCODED_USER ENCODED_PASSWORD
                  ENCODED_USER=$(url_encode_component "$PROXY_USER")
                  ENCODED_PASSWORD=$(url_encode_component "$PROXY_PASSWORD")
                  PROXY_AUTH_STR="${ENCODED_USER}:${ENCODED_PASSWORD}@"
              fi
              export http_proxy="http://${PROXY_AUTH_STR}$PROXY_SERVER:$PROXY_PORT"
              export https_proxy="$http_proxy"
              export HTTP_PROXY="$http_proxy"
              export HTTPS_PROXY="$https_proxy"
              # Mark that proxy was extracted from manifest
              PROXY_FROM_MANIFEST=true
              log_msg "Proxy settings configured: $PROXY_SERVER:$PROXY_PORT"
          else
              log_msg "Proxy server or port not found in proxy.dat file."
          fi
      else
          log_msg "No proxy settings found in manifest or proxy configuration not enabled."
      fi
      
      # Re-enable debug tracing if it was enabled
      [ "$debug_was_enabled" = true ] && set -x
  else
      log_msg "No manifest file ($TEMP_MANIFEST_LINK) or fsdmanifest tool ($PAYLOAD_TEMP_DIR/fsdmanifest) found. Skipping proxy extraction from manifest." 1
      # Re-enable debug tracing if it was enabled before returning
      [ "$debug_was_enabled" = true ] && set -x
      return 1
  fi
}

displayVersionInfo()
{
  repeat() { v=$(printf "%-${2}s" "$3"); echo "${v// /$1}"; }

  # print installed and available repo package versions
  [ ! -f $REPOFILE ] && [ $ISUPGRADE = false ] && cleanrepo=true || cleanrepo=false

  configureESARepo
  getESAAgentVersion

  log_msg "`printf \"\n%-22s %s\n\" "$PRODUCT_NAME" $ESA_VERSION`" 1

  # print script version
  log_msg "`printf \"%-22s %s\n\" $(basename $MYNAME) $MY_VERSION`"

  printf "\nPackage Info:"
  printf "\n  %-20s %-20s %-20s\n" PkgName Installed Available
  printf   "  %-20s %-20s %-20s\n" $(repeat - 20) $(repeat - 20) $(repeat - 20)

  local _pkgs=($SCRIPTS_PACKAGE ${PACKAGES[@]})

  for ((i=0; i<${#_pkgs[@]}; i++)); do
    pkg=${_pkgs[$i]}
    if pkg_installed $pkg; then
      pkgver=$(pkg_version $pkg)
    else 
      pkgver="not installed"
    fi
    if [ $REPO_COMM_STATUS -eq 0 ]; then
      pkgavail=$(avail_pkg_version $pkg)
      ( ( [ -z "$pkgavail" ] && [ "$pkgver" ] ) || ( [[ ! "$pkgver" =~ not ]] && version_ge $pkgver $pkgavail ) ) && pkgavail=$pkgver
      [ "$pkgavail" = "not installed" ] && pkgavail="not_available"
    else pkgavail="not_available"
    fi
    log_msg "`printf \"  %-20s %-20s %-20s\n\" $pkg \"$pkgver\" \"$pkgavail\"`" 1
  done

  disableESARepo
  [ $cleanrepo = true ] && [ $debugMode = false ] && cleanupGPGKeys
  clean_payload_temp_dir
}

checkDependencies()
{
    log_msg "Checking script dependencies"
    local script_deps=('hexdump' 'gpg')
    for dependency in "${script_deps[@]}"; do
    log_msg "Checking dependency $dependency"
    which $dependency 1>/dev/null 2>&1; ret=$?
    if [ $ret -ne 0 ]; then
        error 1 "This script requires the \"$dependency\" utility.  Please install it and re-run this script"
    else
        log_msg "Dependency $dependency found"
    fi
    done
    log_msg "Dependency check complete"
}

#####################
## MAIN FUNCTION
#####################
exit_rc=0;
start_time=$(date '+%s')
trap_with_arg trap_caught INT QUIT HUP PIPE

# Make sure only root can run our script
if [ "$(id -u)" != "0" ]; then
    printf "This script must be run as root\n"
    exit 1
fi

# Check for /run/lock, adjust if not available to /var/run or /var/lock
if [ ! -d `dirname $LOCK_FILE` ]; then
  if [ -d /var/run ]; then LOCK_FILE=/var/run/`basename $LOCK_FILE`
  elif [ -d /var/lock ]; then LOCK_FILE=/var/lock/`basename $LOCK_FILE`
  else LOCK_FILE=/var/tmp/`basename $LOCK_FILE`
  fi
fi


# Detect script aliases
echo $MYNAME |grep -q uninstall && { UNINSTALL=true; INSTALL=false; INSTALL_PARMS+=("--uninstall"); UNINSTALL_PRODUCT=`getval $1`; [ $? = 0 ] && shift; }
echo $MYNAME |grep -q status && { statusOnly=true; INSTALL=false; INSTALL_PARMS+=("--status"); }
echo $MYNAME |grep -q version && { versionOnly=true; INSTALL=false; INSTALL_PARMS+=("--version"); }
echo $MYNAME |grep -q start && { startOnly=true; INSTALL=false; }
echo $MYNAME |grep -q stop && { stopOnly=true; INSTALL=false; }


while [ $# != 0 ]; do
  case "$1" in 
    -f|--force) FORCE=true;; # Force uninstall/install/reinstall (TBD)
    -g|--disable-repo) DISABLE_REPO=true;;
    -p|--update) UPDATE=true;;
    -u|--uninstall) UNINSTALL=true; INSTALL=false; UNINSTALL_PRODUCT=`getval $2`; [ $? = 0 ] && shift;;
    -x|--extract) EXTRACT_PAYLOADS=true; PAYLOAD_TEMP_DIR_DELETE=false; INSTALL=false;;
    -t|--directory) PAYLOAD_TEMP_DIR=`getval $2`; [ $? = 0 ] && shift; PAYLOAD_TEMP_DIR_DELETE=false;;
    -n|--nodelete) PAYLOAD_TEMP_DIR_DELETE=false;;
    -l|--list) LIST_PAYLOADS=true; INSTALL=false;;
    -i|--image) IMAGE=true;;
    -d|--debug) debugMode=true;;
    --product-version) PRODUCT_VERSION=`getval $2`; [ $? = 0 ] && shift;;
    --print-platform) printPlatformInfo=true; INSTALL=false;;
    --help) usage; exit 0;;
    --status) statusOnly=true; INSTALL=false;;
    -V|--version) versionOnly=true; INSTALL=false;;
    *) 
      if [ "$UNINSTALL" = true ] && [ -z "$UNINSTALL_PRODUCT" ] && [[ "$1" != -* ]]; then
        UNINSTALL_PRODUCT="$1"
      else
        usage
        exit 1
      fi
      ;;
  esac
  shift
done

# Check for debugMode after setup of logs
[ $debugMode = true ] && start_debug

(
  flock -ne 10 || { parentHasLock || waitForRunLock; }
  log_msg "=====> Running (pwd $MYDIR): $MYNAME ${INSTALL_PARMS[*]}"
  log_msg "Process parentage: `pstree -A -p $MYPID -s 2>/dev/null |grep $MYPID |sed \"s/\(.*$MYPID\).*/\1\)/\"`"

  checkCpuArch
  checkGLibcVersion
  getPlatform
  checkDependencies
  getProductConfig
  pkgs_installed ${PACKAGES[@]}
  [ $pkgcnt -eq ${#PACKAGES[@]} ] && ISUPGRADE=true || ISUPGRADE=false

  # Extract payloads
  ( [ "$EXTRACT_PAYLOADS" = true ] || [ "$LIST_PAYLOADS" = true ] ) && { extractPayloads 1; exit_rc=$?; }

  # Status only check
  [ "$statusOnly" = true ] && { esaAgentStatus; exit_rc=$?; }

  # Version check
  [ "$versionOnly" = true ] && { displayVersionInfo; exit $?; }

  # Start/stop only (e.g. when run as start.sh or stop.sh; simple copy of instfunlib startAgent/stopAgent)
  [ "$startOnly" = true ] && { startAgent; exit_rc=$?; exit $exit_rc; }
  [ "$stopOnly" = true ] && { stopAgent; exit_rc=$?; exit $exit_rc; }

  if [ "$UNINSTALL" = false ] && [ "$FORCE" = true ]; then
     log_msg "FORCE option works with UNINSTALL\n" 1
     usage
     exit 0
  fi

  # Uninstall 
  if [ "$UNINSTALL" = true ]; then
      isDCSPreventionEnabled && printf 'Agent uninstall failed as DCS prevention policy is applied. Revoke the prevention policy before uninstalling the agent.\n' && exit 1
      uninstallAgent
      exit_rc=$?
      if [ $exit_rc -eq 0 ]; then
        antimalware_feature_update
        cleanupGPGKeys
      fi
      exit $exit_rc
  fi

  if [ $INSTALL = false ] && [ "$versionOnly" != true ]; then
    clean_payload_temp_dir
    exit $exit_rc
  fi

  [ "$IMAGE" = true ] && [ "$ISUPGRADE" = true ] && printf 'Option --image is used with fresh install only.\n' && exit 1

  log_msg "ISUPGRADE : $ISUPGRADE"
  log_msg "PRODUCT_ID : $PRODUCT_ID"
  log_msg "LOGFILE   : $_LOGFILE"

  [ "$PREV_PRODUCT_VERSION" ] && log_msg "PREV_PRODUCT_VERSION=$PREV_PRODUCT_VERSION"

  preInstallChecks
  extractPayloads
  setupManifestLink
  extractAndSetProxySettings
  installGPGKeys

  if [ "$IMAGE" = true ] && [ "$ISUPGRADE" = false ]; then
     touch "$noAgentStart"
     #If a previous install was done we need to clean up the Persisted data
     HW_ID_FILE="/var/opt/Broadcom/EndpointSecurityAgent/appdata/PersistedData/eaphwid.ini"
     [ -f "$HW_ID_FILE" ] && rm -f "$HW_ID_FILE"
  fi 

  installAgent

  if [ ! -f "$noAgentStart" ]; then
    esaAgentStatus "ccsvchst@EapService.service"
    exit_rc=$?
  fi

  if [ "$IMAGE" = true ] && [ "$ISUPGRADE" = false ]; then
     rm -f "$noAgentStart"
     printf "Notice: Installation was ran  with --image switch to create a templated image such as Amazon AMI.\n"
     printf "Instance is ready for Image creation. Please DO NOT Reboot.\n"
     printf "Shutdown the machine at convenience.\n\n\n"
  fi

  [ "$exit_rc" -eq 0 ] && clean_payload_temp_dir

  exit $exit_rc

) 10>$LOCK_FILE; _ret=$?

clean_exit $_ret
