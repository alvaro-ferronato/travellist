log_msg()
{
  _tod=`date +"%D %T"`
  printf "$_tod [$MYPID]: $1\n" >> $_LOGFILE 2>/dev/null
  [ "$2" ] && [ "$2" -eq "1" ] && printf "$1\n"
  return 0
}

clean_exit()
{
   # When in a subshell (subshell from flock), exit for main process exit handler
  [ "$BASHPID" != "$MYPID" ] && disableESARepo && exit $1

  selinux_on
  local _ret=$1
  # In case of VM extension toggles, return success if error code >1 (not so serious .. i.e. status)
  [ $_ret -gt 1 ] && [ $UPDATE = true ] && \
    { log_msg "Ignoring return code $_ret"; _ret=0; }
  log_msg "Runtime: $(expr $(date '+%s') - ${start_time}) seconds"
  [ -L "$TEMP_MANIFEST_LINK" ] && rm -f "$TEMP_MANIFEST_LINK"
  [ $_ret != $exit_rc ] && exit_rc=$_ret
  [ "$_UNINSTALLED" = "true" ] && [ -f $LOCK_FILE ] && rm -f $LOCK_FILE
  clean_payload_temp_dir
  exit $_ret
}

# PAYLOAD_TEMP_DIR_DELETE is set in a sub-shell if a temp directory is not
# provided using the "-t | --directory <dir>" option.
# Ensure we are calling this from within that sub-shell
clean_payload_temp_dir()
{
  if ( [ "$debugMode" = "false" ] && [ "$PAYLOAD_TEMP_DIR_DELETE" = "true" ] ); then
    [ ! -z "$PAYLOAD_TEMP_DIR" ] && [ -d "$PAYLOAD_TEMP_DIR" ] && rm -rf "$PAYLOAD_TEMP_DIR"
  else
    [ ! -z "$PAYLOAD_TEMP_DIR" ] && log_msg "INFO: temporary directory (${PAYLOAD_TEMP_DIR}) will not be deleted" 1
  fi
}

error()
{
   log_msg "Error $1: $2" 1
   printf "Please refer to install logfile $_LOGFILE for more information\n"
   clean_exit $1
}

trap_caught()
{
   error 1 "Script exit on signal $1" 1  
}

trap_with_arg() 
{
   func="$1" ; shift
   for sig in "$@"; do
      trap "$func $sig" "$sig"
   done
}

selinux_off()
{
   if [ -f '/etc/selinux/config' ]; then
     SELINUX_STATUS=$(getenforce 2>/dev/null)
     if [ "$SELINUX_STATUS" = "Enforcing" ]; then
        setenforce 0 >> $_LOGFILE 2>&1 && log_msg "Temporarily disabling SELinux enforcement during installation..."
     fi
   fi
}

selinux_on()
{
   if [ "$SELINUX_STATUS" = "Enforcing" ]; then 
      setenforce 1 >> $_LOGFILE 2>&1 && log_msg "SELinux enforcement re-enabled."
   fi
}

pkg_installed()
{
  case $PLAT_PKG in
    deb) if [ $INSTALL = true ]; then dpkg-query -W -f='${Status}\n' $1 2>/dev/null | grep -q "^install ok installed$";
	 else dpkg-query -W -f='${Status}\n' $1 2>/dev/null | grep -v "not-installed" |grep -qw "^install ok";
         fi;;
    rpm) rpm --quiet -q $1 >/dev/null 2>&1;;
  esac;
  return $?;
}

pkg_deb_in_bad_state()
{
  [ "$PLAT_PKG" != "deb" ] && return 1
  local status
  status=$(dpkg-query -W -f='${Status}\n' $1 2>/dev/null) || return 1
  case "$status" in
    ""|*not-installed*) return 1 ;;  # not in db or not-installed: ok
    "install ok installed") return 1 ;;  # good state
    *) return 0 ;;  # any other state (deinstall ok installed, half-installed, etc.)
  esac
}

pkg_version()
{
  local _ret=0
  if [ -f "$1" ]; then
    log_msg "pkg_version() Debug: 1 = $1 PLAT_PKG = $PLAT_PKG"
    case $PLAT_PKG in
      deb) dpkg -f $1 Version 2>/dev/null |head -n 1; _ret=$?;;
      rpm) v=`rpm -qp --qf "%{VERSION}-%{RELEASE}\n" $1 2>/dev/null |head -n 1`; _ret=$?
              [ $_ret = 0 ] && echo "$v" |sed 's/\([0-9.]*\)-\([0-9]*\)\..*/\1-\2/';;
    esac;
  else
    case $PLAT_PKG in
      deb) dpkg-query -W -f='${Version}\n' $1 2>/dev/null; _ret=$?;;
      rpm) v=`rpm -q $1 >/dev/null 2>&1 && rpm -q --qf "%{VERSION}-%{RELEASE}" $1 2>/dev/null`; _ret=$?
              [ $_ret = 0 ] && echo "$v" |sed 's/\([0-9.]*\)-\([0-9]*\)\..*/\1-\2/';;
    esac;
  fi
  return $_ret
}

check_package_names()
{
  for _p in $*; do
     v=`check_package_ver $_p`
     [ "$v" ] && case $PKG_MGR in zypp|apt) printf "%s " $_p=$v;; *) printf "%s " $_p-$v*;; esac || echo $_p
  done
}
    
# $1 - list of packages to check for specific versions (i.e. --packages parameter)
check_package_ver()
{
  _pkg=$1
  if [ "$SPECIFIC_PACKAGES" ]; then
    local sp=`echo "$SPECIFIC_PACKAGES" |sed 's/\s\+/\n/g' |grep -w $_pkg=.*`
    [ -z "$sp" ] && return 0
    local _v
    case $sp in
      $_pkg=[0-9]*.[0-9]*.[0-9]*[.-][0-9]*) _v=`avail_pkg_version $_pkg true |grep -w ${sp#*=}`;;
      $_pkg=[0-9]*) _pkgidx=`echo "$sp" |cut -d= -f2 |awk '{printf "%d",$0}'`;
             _v=`avail_pkg_version $_pkg true |awk -v idx=$(expr $_pkgidx + 1) 'NR==idx {print $0}'`;;
      *) printf "Invalid package specification for $_pkg. use $_pkg=x.x.x-bld or $_pkg=idx as seen from --list-all";;
    esac
    [ "$_v" ] && echo $_v
  fi

   unset sp _pkg
}

avail_pkg_version()
{
  [ $DISABLE_REPO = true ] && return 1
  
  [ -f $1 ] && return 0
  searchall=${2:-false}

  if [ "$SPECIFIC_PACKAGES" ] && [ "$searchall" = "false" ]; then
    v=`check_package_ver $1`
    log_msg "Specific package $1 $v selected and is available in repo"
    [ "$v" ] && echo $v && return 0
  fi

  case $PKG_MGR in
    dnf | yum) [ $searchall = true ] && PARM="--showduplicates"
          v="`$PKG_MGR -q --disablerepo="*" --enablerepo="ESA" $PARM list available $1 2>>$_LOGFILE |grep ^${1%%-[0-9]*} |awk '{print $2}'`";
          [ -z "$v" ] && \
            v="`$PKG_MGR -q --disablerepo="*" --enablerepo="ESA" $PARM list installed $1 2>>$_LOGFILE |grep ^${1%%-[0-9]*} |awk '{print $2}'`";;
    tdnf) [ $searchall = true ] &&
          v="`$PKG_MGR -q --disablerepo="*" --enablerepo="ESA" list available $1 2>>$_LOGFILE |grep ^${1%%-[0-9]*} | awk '{print $2}'`" || \
          v="`$PKG_MGR -q --disablerepo="*" --enablerepo="ESA" list available $1 2>>$_LOGFILE |grep ^${1%%-[0-9]*} | tail -n 1 | awk '{print $2}'`" 
          [ -z "$v" ] && \
            v="`$PKG_MGR -q --disablerepo="*" --enablerepo="ESA" list installed $1 2>>$_LOGFILE |grep ^${1%%-[0-9]*} |tail -n 1 |awk '{print $2}'`";;
    zypp) [ $searchall = true ] && v="`zypper -n search -sx -r ESA $1 2>>$_LOGFILE |grep \"$1.*| package\" |cut -d\| -f4`" || \
          v="`zypper -vn info -r ESA $1 2>>$_LOGFILE | grep ^Version |cut -d: -f2 |cut -d. -f1-3 |awk '{printf $1}'`";;
    apt) [ $searchall = true ] && v="`apt-cache madison $1 2>>$_LOGFILE |awk '{printf "%s\n",$3}'`" || \
          v=`apt-cache madison $1 2>>$_LOGFILE |head -1 |awk '{printf "%s",$3}'`;;
  esac
  [ "$v" ] && { [ $searchall = true ] && \
    { echo "$v" |sort -r -u -V -t- -k 3 -k1,2 |sed 's/\([0-9.]*\)-\([0-9]*\)\..*/\1-\2/' && return 0; } || \
    { echo "$v" |sed 's/\([0-9.]*\)-\([0-9]*\)\..*/\1-\2/' && return 0; } }
  unset searchall v
  return 1
}

# pkgs_installed()
# $1 - list of packages to query
# Returns: $pkgcnt - number of pkgs installed
# Sets: PKGS_INSTALLED[$pkgcnt]
#       PKGS_INSTALLED_VERSIONS[$pkg]
pkgs_installed()
{
   unset PKGS_INSTALLED PKGS_INSTALLED_VERSIONS; pkgcnt=0
   for pkg in $*; do 
      if pkg_installed $pkg; then
        PKGS_INSTALLED[$pkgcnt]=$pkg
        PKGS_INSTALLED_VERSIONS[$pkgcnt]=`pkg_version $pkg`
        ((pkgcnt++))
      fi
   done
   return $pkgcnt
}

preInstallChecks()
{
  # ESA - bare minimum, we can bring back logic as needed
  # make sure /opt has 751 minimum 
  [ ! -d /opt ] && ( mkdir /opt && chmod 751 /opt; ) ||  chmod o+x /opt
  isDCSPreventionEnabled && printf "Agent install failed as DCS prevention policy is applied. Revoke the prevention policy before installing the agent.\n" && exit 1
  # Debian/Ubuntu: reject broken dpkg state (e.g. "deinstall ok installed" from failed preinstall)
  if [ "$PLAT_PKG" = "deb" ] && pkg_deb_in_bad_state $AGENT_PACKAGE; then
    log_msg "preInstallChecks: $AGENT_PACKAGE is in an unacceptable dpkg state. Run: dpkg --configure -a ; apt --fix-broken install"
    error 1 "Package $AGENT_PACKAGE is in a broken state (e.g. previous upgrade failed). Run: dpkg --configure -a ; apt --fix-broken install ; then retry installation."
  fi
  return 0
}

# Kept in sync with stopAgent() in dev/bin/instfunlib (used by preremove). Copy either way;
# only difference: instfunlib uses logmsg/$LOGFILE/exit 1, agentsetup uses log_msg/$_LOGFILE/return 1.
# 1. Stop nicely: systemctl stop ccsvchst@EapService.service
# 2. List any ccsvchst@*.service still running
# 3. Stop the slice if it exists
# 4. Verify no ccsvchst@* services and slice stopped; return 0 or 1.
stopAgent()
{
  log_msg "Stopping Agent.." 1
  # Check if any ccsvchst services are running (for logging)
  local _running_services
  _running_services=$(systemctl list-units 'ccsvchst@*.service' --state=active --no-legend 2>/dev/null | awk '{print $1}')
  if [ -z "$_running_services" ]; then
    log_msg "stopAgent: No ccsvchst services are running."
  fi

  # 1) Stop nicely (EapService will stop all services)
  log_msg "stopAgent: systemctl stop ccsvchst@EapService.service"
  systemctl stop --no-ask-password ccsvchst@EapService.service >> $_LOGFILE 2>&1 || true
  sleep 1

  # 2) Check for any remaining ccsvchst@*.service; list name and PID, then stop each
  _running_services=$(systemctl list-units 'ccsvchst@*.service' --state=active --no-legend 2>/dev/null | awk '{print $1}')
  if [ -n "$_running_services" ]; then
    log_msg "stopAgent: ccsvchst services still running (ccsvchst@*.service):"
    while IFS= read -r _unit; do
      [ -z "$_unit" ] && continue
      local _pid
      _pid=$(systemctl show "$_unit" --property=MainPID --value 2>/dev/null)
      log_msg "stopAgent:   $_unit  MainPID=$_pid"
      systemctl stop --no-ask-password "$_unit" >> $_LOGFILE 2>&1 || true
    done <<< "$_running_services"
    sleep 1
  else
    log_msg "stopAgent: No other ccsvchst services running."
  fi

  # 3) Stop the slice only if it exists (loaded or active)
  if systemctl list-units --all 'system-ccsvchst.slice' 2>/dev/null | grep -q 'system-ccsvchst.slice'; then
    log_msg "stopAgent: systemctl stop system-ccsvchst.slice"
    systemctl stop --no-ask-password system-ccsvchst.slice >> $_LOGFILE 2>&1 || true
    sleep 1
  else
    log_msg "stopAgent: Slice system-ccsvchst.slice is not loaded; skipping slice stop."
    # Nothing was running and slice not present: success
    if [ -z "$_running_services" ]; then
      log_msg "stopAgent: Agent stopped successfully (nothing to stop)."
      return 0
    fi
  fi

  # 4) Verify: no ccsvchst@* services active and slice inactive
  _running_services=$(systemctl list-units 'ccsvchst@*.service' --state=active --no-legend 2>/dev/null | awk '{print $1}')
  local _slice_state
  _slice_state=$(systemctl is-active system-ccsvchst.slice 2>/dev/null)
  if [ -n "$_running_services" ] || [ "$_slice_state" = "active" ]; then
    log_msg "stopAgent: Failed: services still running and/or slice still active (services: $_running_services, slice: $_slice_state)" 1
    return 1
  fi
  log_msg "Agent stopped successfully." 1
  return 0
}

# Simple start logic (kept in sync with startAgent() in dev/bin/instfunlib).
# Used when agentsetup is run as start.sh; no dependency on instfunlib.
startAgent()
{
  local _noagentstart="/etc/noESAgentStart"
  if [ -f "$_noagentstart" ]; then
    log_msg "startAgent: $_noagentstart exists; skipping agent start." 1
    return 0
  fi

  [ -z "$(systemctl list-units 'ccsvchst@*.service' --state=active --no-legend 2>/dev/null)" ] && \
    { log_msg "Starting Agent.." 1; _action=start; } || \
    { log_msg "Restarting Agent.." 1; _action=restart; }
  systemctl $_action --no-ask-password ccsvchst@EapService.service >> $_LOGFILE 2>&1
  return $?
}

version_lt()
{
  test "$(printf '%s\n' "$@" | sort -V | head -n 1)" = "$1" -a "$1" != "$2";
}

checkCpuArch()
{
  log_msg "Checking CPU architecture requirement"
  local CPU_ARCH=`uname -m`;
  [ "$CPU_ARCH" != "x86_64" ] && log_msg "$CPU_ARCH platform architecture not supported" && error 1 "Linux Distribution not supported"
}

checkMinKernelSupport()
{
  log_msg "Checking minimum kernel version requirement"
  local MIN_KERNEL_VERSION=5.8
  local MIN_REDHAT_KERNEL_VERSION=4.18.0-553

  local kernel_version=$(uname -r | cut -d'.' -f1-2)
  if [[ "$PLAT_OS" = "redhat" ]]; then
    MIN_KERNEL_VERSION=$MIN_REDHAT_KERNEL_VERSION
    kernel_version=$(uname -r | cut -d'.' -f1-3)
  fi

  version_lt $kernel_version $MIN_KERNEL_VERSION && UNSUPPORTED_OS=1
  log_msg "Kernel version: $kernel_version, Minimum kernel required: $MIN_KERNEL_VERSION, UNSUPPORTED_OS flag:$UNSUPPORTED_OS"
}

checkGLibcVersion()
{
  log_msg "Checking GLIBC version requirement"
  local GLIBC_MIN_VERSION=2.28

  # Check glibc >= 2.28
  local GLIBC_VERSION=`ldd --version 2>/dev/null | head -n1 | grep -oE '[0-9]+\.[0-9]+' | head -n1`
  [ "$GLIBC_VERSION" ] && version_lt $GLIBC_VERSION $GLIBC_MIN_VERSION && log_msg "GLIBC version $GLIBC_VERSION is not supported" && error 1 "Linux Distribution not supported"
}

checkBpfSupport()
{
  log_msg "Checking BPF technology support"
  UNSUPPORTED_TECH=0 
  local SECUREBOOT_CHECK=$(grep 'lockdown=confidentiality' /proc/cmdline)
  local BPF_FLAGS=0
  if [ -f /boot/config-$(uname -r) ]; then
      BPF_FLAGS=$(grep -E '^CONFIG_DEBUG_INFO_BTF=y|^CONFIG_BPF_EVENTS=y' /boot/config-`uname -r` |wc -l)
  fi

  if [ $BPF_FLAGS -ne 2 ] || [ ! -z $SECUREBOOT_CHECK ]; then
    log_msg "BPF technology support unavailable"
    UNSUPPORTED_TECH=1
  fi
}

getPlatform()
{
  PLAT_PKG=rpm; PLAT_ARCH=`uname -m`;
  if [ "`uname`" = "Linux" ]; then
    OS=$(grep '^NAME=' /etc/os-release | cut -d= -f2 | tr -d '"')

    FULL_VERSION=$(grep '^VERSION_ID=' /etc/os-release | cut -d= -f2 | tr -d '"')
    # convert to integer
    PLAT_RELEASE="${FULL_VERSION%.*}"
    PERIOD="."
    MINOR_VER=0
    if [[ $FULL_VERSION == *"$PERIOD"* ]]; then
        MINOR_VER="${FULL_VERSION#*.}"
    fi

    # If minimum requirements need to be lowered in the future for other products such as WSS, i.e. Redhat 8.0, modify
    # the below minimum version values.

    MINIMUM_REDHAT_VERSION=8
    MINIMUM_REDHAT_MINOR_VERSION=10
    MINIMUM_UBUNTU_VERSION=22
    MINIMUM_UBUNTU_MINOR_VERSION=04
    MINIMUM_SUSE_VERSION=15
    MINIMUM_SUSE_SERVICEPACK_VERSION=4
    MINIMUM_AMAZON_VERSION=2023
    MINIMUM_DEBIAN_VERSION=11

     if [ -f /etc/redhat-release ] && grep -w "^NAME" /etc/os-release | grep -qEi "Red Hat|CentOS|Oracle|Rocky|AlmaLinux" 2>/dev/null; then  
      if [ "$PLAT_RELEASE" -lt "$MINIMUM_REDHAT_VERSION" ]; then UNSUPPORTED_OS=1
      elif [ "$PLAT_RELEASE" -eq "$MINIMUM_REDHAT_VERSION" ] && [ "$MINOR_VER" -lt "$MINIMUM_REDHAT_MINOR_VERSION" ]; then UNSUPPORTED_OS=1
      else
        PKG_MGR=dnf
        PLAT_OS=redhat
        PLAT_VARIANT="rhel$PLAT_RELEASE"
        PLAT_RELEASE="$FULL_VERSION"
      fi
    elif grep -qi "Ubuntu" /etc/os-release 2>/dev/null; then
      if [ "$PLAT_RELEASE" -lt "$MINIMUM_UBUNTU_VERSION" ]; then UNSUPPORTED_OS=1
      elif [ "$PLAT_RELEASE" -eq "$MINIMUM_UBUNTU_VERSION" ] && [[ "$MINOR_VER" < "$MINIMUM_UBUNTU_MINOR_VERSION" ]]; then UNSUPPORTED_OS=1
      else
        PKG_MGR=apt
        PLAT_OS=$(grep -w ^ID /etc/os-release | cut -d= -f2 | tr -d '"' | tr '[:upper:]' '[:lower:]')
        PLAT_VARIANT="$PLAT_OS$PLAT_RELEASE"
        PLAT_RELEASE="$FULL_VERSION"
      fi
    elif [ -f /etc/system-release ] && grep -w "^NAME" /etc/os-release | grep -qEi "Amazon Linux" 2>/dev/null; then
      if [ "$PLAT_RELEASE" -lt "$MINIMUM_AMAZON_VERSION" ]; then UNSUPPORTED_OS=1
      else 
        PKG_MGR=dnf
        PLAT_OS=amazonami
        PLAT_VARIANT="amzn$PLAT_RELEASE"
      fi
    elif grep -qi "suse.*server" /etc/os-release 2>/dev/null; then
      if [ "$PLAT_RELEASE" -lt "$MINIMUM_SUSE_VERSION" ]; then UNSUPPORTED_OS=1
      elif [ "$PLAT_RELEASE" -eq "$MINIMUM_SUSE_VERSION" ]; then
        SP=$(grep '^VERSION="15-SP' /etc/os-release | sed -E 's/.*-SP([0-9]+)".*/\1/')
        if [[ "$SP" < "$MINIMUM_SUSE_SERVICEPACK_VERSION" ]]; then UNSUPPORTED_OS=1
        else
          PKG_MGR=zypp
          PLAT_OS=suse
          PLAT_VARIANT="sles$PLAT_RELEASE"
          [ $PLAT_RELEASE -eq 15 ] && ( [ $MINOR_VER -eq 4 ] || [ $MINOR_VER -eq 5 ] ) && GPG_CHECK=0; 
        fi
      else
          PKG_MGR=zypp
          PLAT_OS=suse
          PLAT_VARIANT="sles$PLAT_RELEASE"
      fi
    elif grep -qi "debian.*linux" /etc/os-release 2>/dev/null; then 
      if [ "$PLAT_RELEASE" -lt "$MINIMUM_DEBIAN_VERSION" ]; then UNSUPPORTED_OS=1
      else
        PKG_MGR=apt
        PLAT_OS=$(grep -w ^ID /etc/os-release | cut -d= -f2 | tr -d '"' | tr '[:upper:]' '[:lower:]')
        PLAT_VARIANT="$PLAT_OS$PLAT_RELEASE"
        PLAT_RELEASE="$FULL_VERSION"
      fi
    else
      # handle unknown distro
      PLAT_OS="$(grep -w ^ID /etc/os-release | cut -d= -f2 2>/dev/null)"
      PLAT_VARIANT="$PLAT_OS$PLAT_RELEASE"
      PLAT_RELEASE="$FULL_VERSION"
      type yum >/dev/null 2>&1 && PKG_MGR=yum
      type apt >/dev/null 2>&1 && PKG_MGR=apt
      type dnf >/dev/null 2>&1 && PKG_MGR=dnf
      type tdnf >/dev/null 2>&1 && PKG_MGR=tdnf
      type zypper >/dev/null 2>&1 && PKG_MGR=zypp
    fi

    # Finally check Minimum Kernel support
    checkMinKernelSupport
    # BPF support - don't block entire product install for now.
    checkBpfSupport
    if [ -z "$PKG_MGR" ] || [ -n "$UNSUPPORTED_OS" ]; then echo "Linux Distribution not supported"; exit 1; fi
  fi

  if [ ${PKG_MGR} = dnf ] || [ ${PKG_MGR} = tdnf ] || [ ${PKG_MGR} = yum ]; then
    REPO_GPG_PATH=/etc/pki/rpm-gpg/RPM-GPG-KEY-ESA
    REPOFILE=/etc/yum.repos.d/esa.repo
  elif [ ${PKG_MGR} = zypp ]; then
    REPO_GPG_PATH=/etc/pki/trust/anchors/RPM-GPG-KEY-ESA
    REPOFILE=/etc/zypp/repos.d/esa.repo
  elif [ ${PKG_MGR} = apt ]; then
    REPO_GPG_PATH=/usr/share/keyrings/esa.gpg
    REPOFILE=/etc/apt/sources.list.d/esa.list
    PLAT_PKG=deb
    PLAT_ARCH=$(dpkg --print-architecture)
  fi

  [ $printPlatformInfo = true ] && printf "os=$OS $FULL_VERSION\npkg=$PLAT_PKG\n" && exit 0
}

extractPayloads() {
  local log_to_console=${1:-0}

  log_msg "Starting payload extraction..."

  validate_gzip_payload() {

    local input_file="$1"
    local offset="$2"

    gzip_file_flags_dec=$(hexdump -s $((offset + GZIP_FILE_FLAGS_OFFSET)) -n 1 -e '/1 "%u"' "$input_file")

    # FLG bits 5-7 are reserved and can't be 1
    [ $((gzip_file_flags_dec&0x07)) == 0 ] || return 1 

    gzip_os_type_dec=$(hexdump -s $((offset + GZIP_OSID_OFFSET)) -n 1 -e '/1 "%u"' "$input_file")

    # check os_type (0-13 or 255)
    ([ $gzip_os_type_dec -lt 13 ] || [ $gzip_os_type_dec -eq 255 ]) || return 1

    return 0
  }

  # Find the offset of all the gzip payloads
  declare -a gzip_payload_offsets=()
  for offset in $(grep -aob $'\x1F\x8B\x08' "${MYNAME}" | cut -d: -f1); do
    validate_gzip_payload "${MYNAME}" "$offset" && gzip_payload_offsets+=($offset)
  done

  if [ ${#gzip_payload_offsets[@]} -eq 0 ]; then
    log_msg "No payloads found." ${log_to_console}
    return 0
  fi

  # Start of the first payload
  payload_start=${gzip_payload_offsets[0]}

  # Calculate the size of the script
  script_size=$(wc -c < "${MYNAME}")

  # Calculate the size of the payloads
  payload_size=$((script_size - payload_start))

  log_msg "Payload data found. Size: ${payload_size} bytes"

  if [ -z "$PAYLOAD_TEMP_DIR" ]; then
     PAYLOAD_TEMP_DIR=$(mktemp -d ./instXXXXXX)        # Create temp dir in current directory
     PAYLOAD_TEMP_DIR=$(realpath "$PAYLOAD_TEMP_DIR")  # Convert to absolute path
  else
     PAYLOAD_TEMP_DIR=$(realpath "$PAYLOAD_TEMP_DIR")  # Convert existing path to absolute
     mkdir -p "$PAYLOAD_TEMP_DIR"                      # Ensure it exists
     rm -rf "$PAYLOAD_TEMP_DIR"/*                      # Clean up all existing contents
  fi

  # Extract the payload data
  tail -c +"$((payload_start + 1))" "${MYNAME}" > "${PAYLOAD_TEMP_DIR}/payloads.gz"

  unpack_payload() {

    local input_file="$1"
    local count="$2"
    local output_file=""

    gzip_file_flags_dec=$(hexdump -s ${GZIP_FILE_FLAGS_OFFSET} -n 1 -e '/1 "%u"' "$input_file")

    [ $((gzip_file_flags_dec&GZIP_FNAME_MASK)) -gt 0 ] && read -r -d $'\0' output_file < <(tail -c +$((GZIP_HEADER_SIZE + 1)) "$input_file")

    if [ ${LIST_PAYLOADS} = true ]; then
      [ "$output_file" = "" ] && echo "(payload $count) no embedded filename, size ($(stat -c '%s' "$input_file"))" \
        || echo "(payload $count) $output_file"
      return 0
    fi

    if [ "$output_file" = "" ]; then
      log_msg "$input_file does not contain an embedded filename"
      gzip -d "$input_file"
      extracted_input_file=${input_file%.gz}
      grep -iq -e connect -e product_id "${extracted_input_file}" && mv "${extracted_input_file}" "${PAYLOAD_TEMP_DIR}/sea.json"
    else
      log_msg "Renaming $input_file to ${PAYLOAD_TEMP_DIR}/${output_file}.gz and unapacking..."
      mv "$input_file" "${PAYLOAD_TEMP_DIR}/${output_file}.gz"
      gzip -d "${PAYLOAD_TEMP_DIR}/$output_file"
      if [ "$output_file" = "fsdmanifest" ]; then
        chmod +x "${PAYLOAD_TEMP_DIR}/$output_file"
      fi
    fi
  }

  # Split the concatenated gzipped payloads
  split_payloads() {
    local input_file="$1"
    local count=0

    while true; do
      count=$((count + 1))

      if [ $count -gt ${#gzip_payload_offsets[@]} ]; then
        break
      fi

      # Check if the input file is empty
      if [[ ! -s "$input_file" ]]; then
        break
      fi

      local output_file="payload_${count}.gz"
      local output_file_size=0

      if [ $count -eq ${#gzip_payload_offsets[@]} ]; then
        unpack_payload "$input_file" $count
        return 0
      fi

      output_file_size=$(( ${gzip_payload_offsets[$count]} - ${gzip_payload_offsets[$((count - 1))]}  ))

      head -c +${output_file_size} "$input_file" > "$PAYLOAD_TEMP_DIR/$output_file"
      unpack_payload "$PAYLOAD_TEMP_DIR/$output_file" $count

      # Remove the extracted archive from the input file
      tail -c +$((${output_file_size} + 1)) "$input_file" > "${PAYLOAD_TEMP_DIR}/temp.gz"
      mv "${PAYLOAD_TEMP_DIR}/temp.gz" "$input_file"
    done
  }

  split_payloads "${PAYLOAD_TEMP_DIR}/payloads.gz"

  if [[ $? -ne 0 ]]; then
    error 1 "Failed to split payloads."
  fi

  log_msg "Payload extraction completed successfully."
  return 0
}

installGPGKeys() 
{
  pkg_cert=$(find $PAYLOAD_TEMP_DIR -maxdepth 1 -name "*-sea_linux.gpg")

  if [ -z "$pkg_cert" ] || [ ! -f $pkg_cert ]; then
    log_msg "Warning: GPG public key file missing."
    return 0
  fi
       
  log_msg "Running key import for Endpoint Security Agent"
  case $PKG_MGR in
    yum|zypp|dnf|tdnf)
       [ ! -z "$REPO_GPG_PATH" ] && [ -f $REPO_GPG_PATH ] && diff -q $REPO_GPG_PATH $pkg_cert >>$_LOGFILE 2>&1 && \
	       log_msg "Key files already on the system. Nothing to do here." && return 0
       
        if [ "$GPG_CHECK" = 1 ] && ! rpm --import $pkg_cert >>$_LOGFILE 2>&1; then
          log_msg "GPG key import failure for key file $pkg_cert" 1;
        fi
      ;;
    apt)
       if ! gpg --dearmor --yes -o "$REPO_GPG_PATH" "$pkg_cert" >>$_LOGFILE 2>&1; then
          log_msg "GPG key import failure for key file $pkg_cert" 1
       fi
       chmod 0644 "$REPO_GPG_PATH" >>$_LOGFILE 2>&1
      ;;
  esac
}

fold_msg()
{
  local ncols=$((`tput cols 2>/dev/null` - 5));
  ( [ -z "$ncols" ] || [ $ncols -le 0 ] ) && ncols=40;
  ncols=$(( $ncols > 120 ? 120 : $ncols ))
  which fold >/dev/null 2>&1 && echo "$1" |fold -w $ncols -s || echo "$1";
}

box_msg()
{
   fold_msg "$1" | awk 'length($0) > length(longest) { longest = $0 } { lines[NR] = $0 } END { gsub(/./, "=", longest); print "/=" longest "=\\"; n = length(longest); for(i = 1; i <= NR; ++i) { printf("| %s %*s\n", lines[i], n - length(lines[i]) + 1, "|"); } print "\\=" longest "=/" } ' |tee -a $_LOGFILE;
}

isvarset()
{
   DFLTVAR=${2:-%*%}
   ( [ -z "$1" ] || [[ "$1" =~ ($DFLTVAR|FSD_SEPEG_LINUX*) ]] ) && return 1 || return 0
}

performDryRunRHEL()
{
  #log_msg "performDryRunRHEL: Executing install dry run..."
  
  local _upgrade=$1; shift;
  local _pkgs="$*"
  local _cmd="install"
  #log_msg "performDryRunRHEL: _upgrade is $_upgrade"

  [ "$_upgrade" = true ] && [ "$IGNORE_UPGRADE" = false ] && _cmd="upgrade"

  local _disablerepo=""
  [ "$DISABLE_REPO" = true ] && _disablerepo="--disablerepo=*"

  if [ "$PKG_MGR" = "tdnf" ]; then
    $PKG_MGR -y --testonly $_cmd --nogpgcheck $_disablerepo $_pkgs >> "$_LOGFILE" 2>&1
  else
    $PKG_MGR -y $_cmd --setopt tsflags=test --nogpgcheck $_disablerepo $_pkgs >> $_LOGFILE 2>&1
  fi
  yum_dryrun_rc=$?
  
  [ "$yum_dryrun_rc" != 0 ] && { log_msg "Package install dry run failed ($yum_dryrun_rc)." 1; return $yum_dryrun_rc; }
  log_msg "performDryRunRHEL: Package install dry run passed ($yum_dryrun_rc)."
  return $yum_dryrun_rc
}

performDryRunSLES()
{
  log_msg "performDryRunSLES: Executing install dry run..."

  local _upgrade=$1; shift;
  local _pkgs="$*"
  log_msg "performDryRunSLES: _upgrade is $_upgrade"
  log_msg "performDryRunSLES: _pkgs is $_pkgs"

  
  zypper --no-gpg-checks -vn install --dry-run $_pkgs >> $_LOGFILE 2>&1
  zypp_dryrun_rc=$?
  
  [ "$zypp_dryrun_rc" != 0 ] && { log_msg "Package install dry run failed ($zypp_dryrun_rc)." 1; return $zypp_dryrun_rc; }
  log_msg "performDryRunSLES: Package install dry run passed ($zypp_dryrun_rc)."
  
  return $zypp_dryrun_rc
}

performDryRun()
{
  log_msg "performDryRun: Args = $*"

  case $PKG_MGR in
   tdnf | dnf | yum)  performDryRunRHEL "$@"; dryrun_rc=$?;;
   zypp) performDryRunSLES "$@"; dryrun_rc=$?;;
   apt)  dryrun_rc=0;;
   *)    log_msg "performDryRun: Failed to identify package manager." 1; dryrun_rc=1;;
  esac
  return $dryrun_rc
}

match_local_pkg()
{
  #check package in present working dir
  local _local_pkg="$PWD/$1[-][0-9].*.$PLAT_ARCH\.$PLAT_PKG"
  log_msg "match_local_pkg: looking for $_local_pkg"
  log_msg "match_local_pkg: plat_pkg is $PLAT_PKG"
  local _f=`find $PWD -maxdepth 1 -type f -regex "$_local_pkg" 2>/dev/null |sort -V |tail -1`
  [ "$_f" ] && [ -f "$_f" ] && printf "$_f" && return 0

  #check package in payload dir
  _local_pkg="$PAYLOAD_TEMP_DIR/$1[-][0-9].*.$PLAT_ARCH\.$PLAT_PKG"
  log_msg "match_local_pkg: looking for $_local_pkg"
  _f=`find $PAYLOAD_TEMP_DIR -maxdepth 1 -type f -regex "$_local_pkg" 2>/dev/null |sort -V |tail -1`
  [ "$_f" ] && [ -f "$_f" ] && printf "$_f" && return 0
  return 1
}

installPackages()  # ISUPGRADE Package_list
{
  local _ret=0
  local _upgrade=$1; shift;
  local _pkgs=()
  for _pkg in $*; do
    if [ -f "$PWD/$_pkg" ]; then
      _pkgs+=("$PWD/$_pkg")
    else
      _pkgs+=("$_pkg")
    fi
  done
  local num_pkgs=${#_pkgs[@]}
  [ "$debugMode" = "true" ] && printf "\nPress ENTER to continue installation of:\n" && printf "%s\n" "${_pkgs[@]}" && read REPLY
  case $PKG_MGR in
    yum|dnf|tdnf)  if [ $DISABLE_REPO = true ]; then
            yum -y install ${INSTALL_PKG_PARMS} --disablerepo=* "${_pkgs[@]}" >> $_LOGFILE 2>&1; _ret=$?;
          else 
            ret=`yum repolist --disablerepo=* --enablerepo=ESA ESA 2>&1`; 
            echo "$ret" | grep -q "Repository ESA is listed more than once"; _ret=$?
            [ "$_ret" = 0 ] && { \
	            log_msg "Repository ESA is listed more than once.  Please check repo files in $(dirname $REPOFILE) for a duplicate repo for \"ESA\"." 1;
		          return 1; }
            _ret=0
            [ $_upgrade = true ] && [ $IGNORE_UPGRADE = false ] && yum -y upgrade ${INSTALL_PKG_PARMS} --disablerepo=* --enablerepo=ESA "${_pkgs[@]}" >> $_LOGFILE 2>&1 || \
            yum -y install ${INSTALL_PKG_PARMS} --disablerepo=* --enablerepo=ESA "${_pkgs[@]}" >> $_LOGFILE 2>&1; _ret=$?;
          fi;;
    zypp) [ "$GPG_CHECK" = 0 ] && INSTALL_PKG_PARMS="--no-gpg-checks $INSTALL_PKG_PARMS"
          [ $_upgrade = true ] && zypper ${INSTALL_PKG_PARMS} -vn update -r ESA "${_pkgs[@]}" >> $_LOGFILE 2>&1 || \
	        [ $DISABLE_REPO = true ] && zypper ${INSTALL_PKG_PARMS} -vn install "${_pkgs[@]}" >> $_LOGFILE 2>&1 || \
          zypper ${INSTALL_PKG_PARMS} -vn install -r ESA "${_pkgs[@]}" >> $_LOGFILE 2>&1; _ret=$?;
          case $_ret in 10[0-4,6]) _ret=0;; esac;;
    apt)  ( [ "$_reinstall" = "true" ] || [ $FORCE = true ] ) && INSTALL_PKG_PARMS="--reinstall $INSTALL_PKG_PARMS"
           apt-get install -y ${INSTALL_PKG_PARMS}  "${_pkgs[@]}" >>$_LOGFILE 2>&1; _ret=$?;;
  esac
  return $_ret
}

reportTelemetry()
{
    local TELEMETRY_UC="{25165902-034F-4038-9B28-7D3A7008B131}"
    if [ "${PLAT_ARCH}" = "aarch64" ]; then
        TELEMETRY_UC="{B4015E96-7E7F-4569-A668-6B8464DE0092}"
    fi

    local TELEMETRY_NEWPKG="${NEW_ESA_VERSION},en-US,${TELEMETRY_UC}"

    # Default to install
    local TELEMETRY_PREVPKG=""
    local TELEMETRY_ACTION=1
    if [ "${ISUPGRADE}" = "true" ]; then
        # migration
        TELEMETRY_ACTION=2
        TELEMETRY_PREVPKG="${PREV_ESA_VERSION},en-US,${TELEMETRY_UC}"
    else
        if [ "${UNINSTALL}" = "true" ]; then
            TELEMETRY_ACTION=4
        fi
    fi

    local TELEMETRY_DEPLOY=1
    if [[ "${MYNAME}" == "/var/opt/Broadcom/EndpointSecurityAgent/definitions/symcdata/symplatforminstallerdefs"* ]]; then
        TELEMETRY_DEPLOY=4
    fi

    local TELEMETRY_TOOL="$PAYLOAD_TEMP_DIR/fsdmanifest"
    local TELEMETRY_LOGFILE="/var/log/esa_agentsetup.log"
    local TELEMETRY_CMD="${TELEMETRY_TOOL} --telemetry_action ${TELEMETRY_ACTION} --telemetry_result $1 --telemetry_deployment ${TELEMETRY_DEPLOY} --telemetry_log ${TELEMETRY_LOGFILE} --telemetry_newpkg ${TELEMETRY_NEWPKG}"
    if [ "${TELEMETRY_ACTION}" = "2" ]; then
        TELEMETRY_CMD="${TELEMETRY_CMD} --telemetry_prevpkg ${TELEMETRY_PREVPKG}"
    fi
    ${TELEMETRY_CMD} 2>&1 >> $_LOGFILE; ret=$?
    log_msg "Telemetry command (${TELEMETRY_CMD}) returned ${ret}"
    return ${ret}
}

installAgent()
{
  _reinstall=false

  configureESARepo
  getESAAgentVersion
  [ "$ESA_VERSION" ] && _VERSION=$ESA_VERSION || _VERSION=$PRODUCT_VERSION
  if [ "$PREV_PRODUCT_VERSION" ] && [ $PREV_PRODUCT_VERSION != $PRODUCT_VERSION ]; then
    log_msg "`printf \"\nUpgrading %-22s %s to %s\n\" "$PRODUCT_NAME" $PREV_PRODUCT_VERSION $PRODUCT_VERSION`" 1
  else log_msg "`printf \"\n%-22s %s\n\" "$PRODUCT_NAME" $_VERSION`" 1
  fi

  # look for any local packages first
  pkgs_installed ${PACKAGES[*]}; pkgs_installed=$?
  declare -a INSTALL_PKGS=() pkgs_msg=()
  i=0; j=0
  for pkg in ${PACKAGES[@]}; do 
    pkg_name=$pkg
    log_msg "installAgent() pkg: $pkg"
    localfile="`match_local_pkg $pkg`"
    repo_pkg_ver=`avail_pkg_version $pkg`
    installed_pkg_ver=`pkg_version $pkg`
    
    if [ "$localfile" ]; then
      log_msg "installAgent() localfile: $localfile"
      local_pkg_ver=`pkg_version $localfile`
    fi
    
    # Select local or repo package for consideration
    if [ "$localfile" ] && ( [ -z "$repo_pkg_ver" ] || \
       ( [ "$repo_pkg_ver" ] && version_ge $local_pkg_ver $repo_pkg_ver ) ); then
      log_msg "installAgent() local package selected"
      [ "$PKG_MGR" = "tdnf" ] && IGNORE_UPGRADE=true
      pkg=$localfile; pkg_ver=$local_pkg_ver; pkgsrc="file";
      
    elif  [ -z "$repo_pkg_ver" ]; then log_msg "No available package version found for $pkg"
    else 
      if [ "$localfile" ] && [ $ISUPGRADE = false ]; then
         log_msg "selecting local file package for $pkg install $pkg ($local_pkg_ver, repo version $repo_pkg_ver)"
        pkg=$localfile; pkg_ver=$local_pkg_ver; pkgsrc="file";
      else
        pkg_ver=$repo_pkg_ver; pkgsrc="repo"; pkg=`check_package_names $pkg`
        log_msg "selecting package from repo for install $pkg ($pkg_ver)"
      fi
    fi
    
    if [ "$installed_pkg_ver" ] && [ "$pkg_ver" ] && version_ge $installed_pkg_ver $pkg_ver && \
       pkg_installed $pkg_name && [ $FORCE = false ]; then
         log_msg "\nNo update needed for ${PACKAGES[$i]} ($installed_pkg_ver)" 1
    elif [ "$pkg_ver" ]; then INSTALL_PKGS[$j]="${pkg}";
      if [ "$installed_pkg_ver" ]; then INSTALL_PKGS_VER[$j]="${pkg}-${pkg_ver}"
         pkgs_msg[$j]="`printf ' %-40s %-15s -> %-15s (%s)' $(basename $pkg) $installed_pkg_ver $pkg_ver $pkgsrc`"
         [ "$installed_pkg_ver" = "$pkg_ver" ] && log_msg "Reinstalling ${PACKAGES[$i]} ($installed_pkg_ver)" 1 && _reinstall=true
      else pkgs_msg[$j]="`printf ' %-40s %-15s (%s)' $(basename $pkg) $pkg_ver $pkgsrc`"
      fi
      ((j++));
    fi
    if [ "$pkg_name" = $AGENT_PACKAGE ]; then  
      PREV_ESA_VERSION="$installed_pkg_ver"
      NEW_ESA_VERSION="$pkg_ver"
      PREV_ESA_VERSION="${PREV_ESA_VERSION//-/.}"
      NEW_ESA_VERSION="${NEW_ESA_VERSION//-/.}"
      log_msg "installAgent(): PREV_ESA_VERSION = $PREV_ESA_VERSION"
      log_msg "installAgent(): NEW_ESA_VERSION = $NEW_ESA_VERSION"
      export DO_NOT_SEND_TELEMETRY
    fi
    ((i++));
    unset repo_pkg_ver installed_pkg_ver local_pkg_ver pkg pkg_ver pkgsrc
  done

  if [ ${#INSTALL_PKGS[@]} -eq 0 ] && [ $FORCE = false ]; then
     # Scenario 1: NEW INSTALL - No packages available from repo
     if [ $ISUPGRADE = false ] && [ $pkgs_installed -eq 0 ]; then
       # New install requires repo access to get packages
       if [ $REPO_COMM_STATUS -eq 1 ]; then
         if [ $REPO_CERT_ERROR -eq 1 ]; then
           error 1 "Repository access failed due to SSL certificate validation error."
         else
           error 1 "Repository communication failure. Please verify network connectivity and proxy settings if applicable."
         fi
       elif [ ! -z "$http_proxy" ] || [ ! -z "$https_proxy" ]; then
         error 1 "No packages available from repository. Please verify proxy configuration and network connectivity."
       else
         error 1 "No packages available from repository. Please check repository configuration and network connectivity."
       fi
     
     # Scenario 2: UPGRADE - Packages already installed, checking for updates
     elif [ $ISUPGRADE = true ]; then
       # If repo communication failed during upgrade check
       if [ $REPO_COMM_STATUS -eq 1 ]; then
         # Couldn't verify if updates are available
         log_msg "Warning: Repository communication failed. Unable to check for updates." 1
         log_msg "Installed packages may not be at the latest version." 1
         if [ $REPO_CERT_ERROR -eq 1 ]; then
           error 1 "Repository access failed due to SSL certificate validation error."
         else
           error 1 "Repository communication failure during upgrade check. Please verify network connectivity and proxy settings."
         fi
       else
         # Repo was accessible, confirmed no updates needed
         log_msg "${MYNAME}. No packages found that need update\n" 1 1 ;clean_exit 0
       fi
     
    # Scenario 3: Other cases - packages installed, not explicitly upgrade mode
    else
      # If repo failed but packages are already present, this is acceptable
      if [ $REPO_COMM_STATUS -eq 1 ] && [ $pkgs_installed -gt 0 ]; then
        log_msg "Warning: Repository communication failed, but all required packages are already installed." 1
      fi
      log_msg "${MYNAME}. No packages found that need update\n" 1 1
      clean_exit 0
    fi
  fi
  if [ $ISUPGRADE = false ]; then
     # print install message
     log_msg "\nInstalling packages:" 1
     log_msg "`printf ' %-40s %-15s %s\n' Package Version Source`" 1
     log_msg " ---------------------------------------- --------------- ------" 1
     log_msg "`for ((i=0; i< ${#pkgs_msg[@]}; i++)); do printf "%s\n" "${pkgs_msg[$i]}"; done`\n" 1 
  else  #Upgrading
     # print upgrade message
     log_msg "\nUpdating packages:\n" 1
     log_msg "`printf ' %-40s %-15s    %-15s %s\n' Package Installed Update Source`" 1
     log_msg " ---------------------------------------- ---------------    --------------- ------" 1
     log_msg "`for ((i=0; i< ${#pkgs_msg[@]}; i++)); do printf "%s\n" "${pkgs_msg[$i]}"; done`\n" 1 
  fi

  ret=0
  if [ ${#INSTALL_PKGS[@]} -ne 0 ]; then
    performDryRun $ISUPGRADE "${INSTALL_PKGS[@]}"; ret=$?  
    if [ $ret != 0 ]; then
      disableESARepo   # Always leave Repo disabled
      log_msg "${MYNAME}: Install dry run failed on $OS"
      # TODO: check if the stub needs to report telemetry information or if EAP already handles it
      reportTelemetry 2
      [ $ISUPGRADE = true ] && { error 1 "Agent upgrade of packages failed: ${INSTALL_PKGS_VER[*]}"; } || \
        error 1 "Agent install failed.";
    fi
  fi

  # Stop agent before upgrade only after dry run has passed
  if [ ${#INSTALL_PKGS[@]} -ne 0 ] && [ $ISUPGRADE = true ]; then
    stopAgent || error 1 "Cannot stop the agent for upgrade. Stop the agent services manually and retry."
  fi
  selinux_off
  ret=0

  # Install or update the agent packages
  installPackages $ISUPGRADE "${INSTALL_PKGS[@]}"; ret=$?
  if [ $ret != 0 ]; then
    disableESARepo   # Always leave Repo disabled
     # TODO: check if the stub needs to report telemetry information or if EAP already handles it
     if [ $ISUPGRADE = true ]; then
       reportTelemetry 2
       log_msg "Restoring agent services after upgrade package install failure..."
       startAgent
       [ $? -ne 0 ] && log_msg "Warning: Failed to restore agent services after install failure. Manual intervention may be required: systemctl start ccsvchst@EapService.service" 1
       error 1 "Agent upgrade of packages failed: ${INSTALL_PKGS_VER[*]}";
     else
       reportTelemetry 2
       error 1 "\nAgent install failed please check error log $_LOGFILE";
     fi
  else
     # TODO: check if the stub needs to report telemetry information or if EAP already handles it
     if [ $ISUPGRADE = true ]; then
       log_msg "Agent upgrade of packages successful: ${INSTALL_PKGS_VER[*]}" 1
       reportTelemetry 0
     else
       log_msg "\nAgent installed successfully" 1
       reportTelemetry 0
     fi
     
     # Clean up proxy configuration after successful installation
     if [ "$PROXY_FROM_MANIFEST" = "true" ]; then
       log_msg "Cleaning up proxy configuration from repository files"
       configureRepoProxy ""
     fi
  fi

  # Always leave Repo disabled
  disableESARepo

  selinux_on
  return 0;
}

checkPackageStatus()
{
  [ "$UNINSTALL" = true ] && return 0
  pkgs_installed ${PACKAGES[*]}
  if [ $? -lt `expr ${#PACKAGES[@]}` ]; then
    log_msg "Agent is not fully installed, not all packages are installed" 1
    return 1
  fi
  return 0
}

esaAgentStatus()
{
  _filter=$1

  checkPackageStatus || return 1

  systemctl status ${DAEMONS} >> $_LOGFILE 2>&1

  # Check agent status
  printf "\nDaemon status:\n"
  
  running_daemons=( $(systemctl status ${DAEMONS} | grep -o "ccsvchst@.*\.service") )

  if [ ${#running_daemons[@]} -eq 0 ]; then
      [ "$statusOnly" = true ] && log_msg "ESA services are not running" 1 && return 0
      log_msg "Error 2: ESA services failed to start" 1
      return 2
  fi

  for agent in ${running_daemons[@]}; do 
    [ ! -z "$_filter" ] && [ "$agent" != "$_filter" ] && continue
    printf "  %-20s %s\n" $agent "running"
  done

  return 0
}

getESAAgentVersion()
{
   if [ $PRODUCT_ID = ESA ]; then
     # If packages are already installed, query installed package
     if pkg_installed $AGENT_PACKAGE; then
       esa_pkg_ver=$(pkg_version $AGENT_PACKAGE)
     elif match_local_pkg $AGENT_PACKAGE >/dev/null; then
       esa_pkg_ver=$(pkg_version `match_local_pkg $AGENT_PACKAGE`)
     fi
     [ -z "$esa_pkg_ver" ] && esa_pkg_ver=`avail_pkg_version $AGENT_PACKAGE`

     
     if [ "$esa_pkg_ver" ]; then
       # ESA_VERSION has format x.y.z (no build number)
       export ESA_VERSION="`echo $esa_pkg_ver |sed 's/\([0-9].*\.[0-9].*\.[0-9].*\)[\.-]\([0-9].*\)/\1/'`"
       export build_no="`echo $esa_pkg_ver |sed 's/\([0-9].*\.[0-9].*\.[0-9].*\)[\.-]\([0-9].*\)/\2/'`"
       log_msg "ESA_VERSION=$ESA_VERSION build_no=$build_no"
     fi
   fi
}

pkg_install()
{
  rc=1
  log_msg "pkg_install: Installing packages $*"
  case $PKG_MGR in
   tdnf | dnf | yum) $PKG_MGR -y install $* >>$_LOGFILE 2>&1; rc=$?;;
   apt) apt-get -y install $* >>$_LOGFILE 2>&1; rc=$?;;
   zypp) zypper -vn install $* >>$_LOGFILE 2>&1; rc=$?;;
  esac
  return $rc
}

pkg_uninstall()
{
  rc=0
  [ "$debugMode" = "true" ] && printf "\nPress ENTER to continue uninstallation of $*" && read REPLY
  log_msg "Removing packages $*" 1
  case $PKG_MGR in
   tdnf | dnf | yum) $PKG_MGR remove -y $* >>$_LOGFILE 2>&1; rc=$?;;
   apt) apt-get purge -y $* >>$_LOGFILE 2>&1; rc=$?;;
   zypp) zypper -vn rm $* >>$_LOGFILE 2>&1; rc=$?;;
  esac
  return $rc
}

pkg_forceUninstall()
{
    rc=0
    [ "$debugMode" = "true" ] && printf "\nPress ENTER to continue force uninstallation of $*" && read REPLY
    log_msg "Force removing packages $*" 1
    for pkg in $*; do
        pkg_installed $pkg; inst=$?
        if [ $inst -gt 0 ]; then
            log_msg "Package $pkg is already removed" 1
            continue
        fi
        case $PLAT_PKG in
            rpm)
                v=`rpm -q $pkg`
                for ver in $v; do
                    log_msg "Removing $ver" 1
                    rpm -e $ver >>$_LOGFILE 2>&1; ret=$?
                    if [ $ret -gt 0 ]; then
                        log_msg "Force removing $ver" 1
                        rpm -e --justdb --nodeps --noscripts $ver >>$_LOGFILE 2>&1; ret=$?
                        if [ $ret -gt 0 ]; then
                            log_msg "Failed to force remove $ver" 1
                            rc=1
                        fi
                    fi
                done
                ;;
            deb)
                log_msg "Removing $pkg" 1
                dpkg --purge $pkg >>$_LOGFILE 2>&1; ret=$?
                if [ $ret -gt 0 ]; then
                    log_msg "Force removing $pkg" 1
                    dpkg --purge --force-all $pkg >>$_LOGFILE 2>&1; ret=$?
                    if [ $ret -gt 0 ]; then
                        prermscr="/var/lib/dpkg/info/$pkg.prerm"
                        printf '#!/bin/bash\nexit 0\n%s\n' "$(cat $prermscr)" > $prermscr
                        log_msg "Force removing with modified $prermscr"
                        dpkg --purge --force-all $pkg >>$_LOGFILE 2>&1; ret=$?
                        if [ $ret -gt 0 ]; then
                            log_msg "Failed to force remove $ver" 1
                            rc=1
                        fi
                    fi
                fi
                ;;
        esac
    done
    return $rc
}

