uninstallAgent()
{
    UNINSTALL_PRODUCT=${UNINSTALL_PRODUCT^^}  #convert to uppercase for script
    log_msg "Uninstallation invoked with UNINSTALL_PRODUCT=\"${UNINSTALL_PRODUCT}\" FORCE=\"${FORCE}\""
    pkgs_installed ${PACKAGES[*]} && { log_msg "Agent is not installed" 1; return 0; }

    # Check if agent is running (only if not using --force)
    if ! pgrep -f "ccsvchst.*EapService" >/dev/null 2>&1; then
        if [ $FORCE = false ]; then
            log_msg "Agent is not running. Cannot proceed with uninstall." 1
            log_msg "Please either:" 1
            log_msg "  1. Start the agent and retry: agentcli service start" 1
            log_msg "  2. Force uninstall: /usr/lib/broadcom/esa/uninstall.sh --force" 1
            return 1
        fi
    fi

    if [ $FORCE = false ]; then
        # Check if platform is installed first
        checkPlatformInstalled; ret=$?
        if [ $ret -eq 6 ]; then
            log_msg "Platform is not installed or liveupdated yet, uninstalling the platform ..." 1
            pkg_cleanup_helper
            return 0
        fi

        # Are there any products installed?
        checkProducts; ret=$?
        if [ $ret -eq 0 ]; then
            # Product uninstall
            esaProductUninstall; ret=$?
            if [ $ret -ne 0 ]; then
                if [ $ret -eq 10 ]; then
                    log_msg "\nTo uninstall a product, please run:" 1
                    for product in ${CHECK_INSTALLED_PRODUCTS}; do
                        log_msg "    /usr/lib/broadcom/esa/uninstall.sh $product" 1
                    done
                    log_msg "\nTo force uninstall all ${PRODUCT_ID} products, run: /usr/lib/broadcom/esa/uninstall.sh --force" 1
                fi
                return $ret
            fi
            checkProducts; ret=$?
            if [ $ret -eq 0 ]; then
                # There are still other products installed, bail out
                log_msg "There are still additional products installed" 1
                return 1
            else
                if [ $ret -eq 1 ]; then
                    log_msg "Product uninstall completed successfully, but now unable to communicate with the Agent" 1
                    return $ret
                fi
            fi
        else
            if [ $ret -eq 2 ]; then
                if [ "${UNINSTALL_PRODUCT}" != "" ]; then
                    # User specified a product name, and it is not installed
                    if [ "$FORCE" = false ]; then
                       log_msg "The ${UNINSTALL_PRODUCT} product is not installed (you may use -f option to uninstall)" 1
                       return $ret
                    fi
                else
                #     If no products are installed  ($ret -eq 2)
                #     and no product is specified to uninstall ("${UNINSTALL_PRODUCT}" = "")
                #     then proceed with uninstall the platform below
                    log_msg "No products are installed and no product is specified to uninstall"
                fi

            else
                #We exhausted communication tries with agent proceeding to uninstall the platform
                log_msg "Error trying to communicate with the Agent, uninstalling the $PRODUCT_ID platform ..." 1
            fi
        fi
    fi

    # Now on to the platform
    pkg_cleanup_helper

}

pkg_cleanup_helper()
{
    [ $FORCE = false ] && \
      log_msg "No additional products installed, uninstalling the $PRODUCT_ID platform ..." 1

    local _msg=$(for (( i=0; i<${#PKGS_INSTALLED[*]}; i++ )); do printf ${PKGS_INSTALLED[$i]}-${PKGS_INSTALLED_VERSIONS[$i]}\ ; done; )
    log_msg "Found packages to uninstall: $_msg"
